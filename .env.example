# CenkorProcess docker-compose 环境变量示例。复制为 .env 后按需修改。
#   cp .env.example .env

# 对外端口（容器内部固定：backend 8600 / web-admin 80）
APP_PORT=8600
WEB_ADMIN_PORT=8082

# 生产务必替换为 ≥32 位强随机值：
#   生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=MUST_CHANGE_ME_in_production

# 后端可选覆盖（默认走 docker-compose.yml 内置值）
# PUBLIC_BASE_URL=http://localhost:8082
