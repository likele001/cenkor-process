APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8600
DB_URL=mysql+pymysql://cenkorpro:PASSWORD@127.0.0.1:3306/cenkorpro?charset=utf8mb4
DB_ECHO=false
# schema 由 Alembic 管理（`alembic upgrade head`）；保持 false。仅本地临时起库才置 true
DB_AUTO_CREATE=false
DB_AUTO_SEED=true
ALLOW_NEGATIVE_STOCK=false
# 为空 = dev 放行；非空则所有 /api 请求需带 X-API-Key 头
API_KEY=<请设置你的密钥>
CORS_ORIGINS=
TRUSTED_HOSTS=